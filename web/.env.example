VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# RevenueCat public API key for the iOS app (Project settings → API keys → App specific keys, starts appl_).
# Only the iOS build uses it; without it the app shows the store with no prices or buttons.
VITE_REVENUECAT_IOS_KEY=appl_...
